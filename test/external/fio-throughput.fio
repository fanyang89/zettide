[global]
ioengine=psync
iodepth=1
buffered=1
direct=0
directory=${FIO_DIR}
rw=${FIO_RW}
bs=1m
fallocate=none
overwrite=1
allow_file_create=${FIO_ALLOW_FILE_CREATE}
end_fsync=${FIO_END_FSYNC}
invalidate=1
group_reporting=1

[sequential-1]
filename=sequential-1.bin
size=${FIO_SINGLE_SIZE}

[sequential-4]
stonewall=1
filename_format=sequential-4.$jobnum.bin
numjobs=4
size=${FIO_MULTI_SIZE}
