[global]
ioengine=psync
iodepth=1
buffered=1
direct=0
directory=${FIO_DIR}
filename_format=$jobname.$jobnum.$filenum
create_on_open=1
allow_file_create=${FIO_ALLOW_FILE_CREATE}
fallocate=none
overwrite=1
unlink=0
verify=crc32c
do_verify=1
verify_fatal=1
verify_dump=1
verify_header_seed=${FIO_VERIFY_HEADER_SEED}
verify_state_save=0
verify_state_load=0
randrepeat=1
randseed=1592594996
end_fsync=1
group_reporting=1

[small-files]
rw=write
bs=4k
numjobs=4
nrfiles=64
openfiles=1
filesize=4k
size=256k
file_service_type=sequential
fsync=16

[sequential-large-files]
stonewall=1
rw=write
bs=1m
numjobs=2
nrfiles=4
openfiles=1
filesize=16m
size=64m
file_service_type=sequential
fsync=4

[random-large-files]
stonewall=1
rw=randwrite
bs=4k
numjobs=4
nrfiles=2
openfiles=2
filesize=16m
size=32m
file_service_type=roundrobin
fsync=128
